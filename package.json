{
  "name": "islandcn-vanilla",
  "version": "0.1.0",
  "description": "islandcn's Dynamic Island engine and presets, ported from React to plain TypeScript and DOM.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/designxdevelop/islandcn-vanilla.git"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./presets": {
      "types": "./dist/presets/index.d.ts",
      "default": "./dist/presets/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "LICENSE-hugeicons.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "verify": "npm run typecheck && npm run test && npm run build",
    "prepublishOnly": "npm run verify"
  },
  "devDependencies": {
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  },
  "keywords": [
    "dynamic-island",
    "islandcn",
    "animation",
    "spring",
    "vanilla",
    "typescript"
  ],
  "homepage": "https://github.com/designxdevelop/islandcn-vanilla#readme"
}
